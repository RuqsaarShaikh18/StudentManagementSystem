<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudentHub - Student Management System</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: "Segoe UI", Arial, sans-serif; }
  body { display: flex; min-height: 100vh; background: #f1f4fa; color: #27334b; }

  .sidebar { width: 230px; background: #192743; color: #fff; padding: 28px 16px; flex-shrink: 0; }
  .sidebar h1 { font-size: 26px; }
  .sidebar small { display: block; color: #becce6; font-size: 11px; letter-spacing: 1px; margin: 4px 0 30px; }
  .nav-btn { display: block; width: 100%; text-align: left; padding: 12px 16px; margin-bottom: 6px;
             background: transparent; color: #fff; border: none; border-radius: 6px; cursor: pointer; font-size: 14px; font-weight: bold; }
  .nav-btn:hover { background: #26395e; }
  .nav-btn.active { background: #4a7bff; }

  .main { flex: 1; padding: 28px 32px; overflow-x: auto; }
  .main h2 { font-size: 28px; }
  .main .sub { color: #78849b; margin: 6px 0 24px; font-size: 14px; }
  .page { display: none; }
  .page.active { display: block; }

  .card { background: #fff; border: 1px solid #dce3f0; border-radius: 8px; padding: 24px; margin-bottom: 20px; }
  .stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-bottom: 22px; }
  .stat { background: #fff; border-radius: 8px; padding: 20px; border-left: 6px solid #4a7bff; }
  .stat:nth-child(2) { border-color: #22a66e; }
  .stat:nth-child(3) { border-color: #ff983d; }
  .stat .label { font-size: 12px; font-weight: bold; color: #78849b; }
  .stat .value { font-size: 28px; font-weight: bold; margin-top: 8px; }

  .btn { padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: bold; color: #fff; }
  .btn-primary { background: #4a7bff; }
  .btn-success { background: #22a66e; }
  .btn-danger { background: #e84355; }
  .btn-secondary { background: #e2e8f5; color: #27334b; }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 22px; margin-bottom: 22px; }
  .form-grid label { display: block; font-weight: bold; font-size: 13px; margin-bottom: 6px; }
  input, select { width: 100%; padding: 10px 12px; border: 1px solid #dce3f0; border-radius: 6px; font-size: 14px; }

  .toolbar { display: flex; gap: 10px; margin-bottom: 16px; }
  .toolbar input { flex: 1; }
  .actions { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }

  table { width: 100%; border-collapse: collapse; background: #fff; }
  th { background: #192743; color: #fff; text-align: left; padding: 12px; font-size: 13px; }
  td { padding: 10px 12px; border-bottom: 1px solid #eef1f8; font-size: 14px; }
  tr:nth-child(even) td { background: #f8fafe; }
  tr.selected td { background: #4a7bff !important; color: #fff; }
  tr { cursor: pointer; }
  .empty { text-align: center; color: #78849b; padding: 20px; }
  .info { font-weight: bold; font-size: 13px; margin-bottom: 12px; }
  .table-wrap { border: 1px solid #dce3f0; border-radius: 8px; overflow: hidden; }

  @media (max-width: 800px) {
    body { flex-direction: column; }
    .sidebar { width: 100%; }
    .stats, .form-grid { grid-template-columns: 1fr; }
  }
</style>
</head>
<body>

<div class="sidebar">
  <h1>StudentHub</h1>
  <small>CAMPUS ADMIN</small>
  <button class="nav-btn active" data-page="dashboard">Dashboard</button>
  <button class="nav-btn" data-page="students">Students</button>
  <button class="nav-btn" data-page="add">Add Student</button>
  <button class="nav-btn" data-page="update">Update Student</button>
  <button class="nav-btn" data-page="delete">Delete Student</button>
</div>

<div class="main">
  <h2 id="pageTitle">Dashboard</h2>
  <p class="sub" id="pageSub">Welcome to StudentHub.</p>

  <!-- DASHBOARD -->
  <div class="page active" id="page-dashboard">
    <div class="stats">
      <div class="stat"><div class="label">TOTAL STUDENTS</div><div class="value" id="totalStudents">0</div></div>
      <div class="stat"><div class="label">COURSES</div><div class="value" id="totalCourses">0</div></div>
      <div class="stat"><div class="label">STATUS</div><div class="value">Ready</div></div>
    </div>
    <div class="card">
      <h3>Welcome to StudentHub</h3>
      <p style="margin:12px 0 22px; color:#78849b;">Student records ko ek jagah manage karein. Data aapke browser mein save hota hai.</p>
      <button class="btn btn-primary" data-goto="add">Add New Student</button>
      <button class="btn btn-secondary" data-goto="students">View Students</button>
    </div>
  </div>

  <!-- STUDENTS -->
  <div class="page" id="page-students">
    <div class="toolbar">
      <input type="text" id="searchInput" placeholder="Search by any detail...">
      <button class="btn btn-primary" id="searchBtn">Search</button>
      <button class="btn btn-secondary" id="resetBtn">Reset</button>
    </div>
    <div class="table-wrap"><table id="studentsTable"></table></div>
    <div class="actions">
      <button class="btn btn-primary" id="goUpdateBtn">Update Selected</button>
      <button class="btn btn-danger" id="delFromListBtn">Delete Selected</button>
    </div>
  </div>

  <!-- ADD -->
  <div class="page" id="page-add">
    <div class="card">
      <div class="form-grid">
        <div><label>Roll Number *</label><input id="addRoll"></div>
        <div><label>Full Name *</label><input id="addName"></div>
        <div><label>Course *</label><input id="addCourse"></div>
        <div><label>Year</label>
          <select id="addYear"><option>FY</option><option>SY</option><option>TY</option><option>Other</option></select>
        </div>
        <div><label>Phone</label><input id="addPhone"></div>
        <div><label>Email</label><input id="addEmail"></div>
      </div>
      <button class="btn btn-success" id="addBtn">Add Student</button>
      <button class="btn btn-secondary" id="clearAddBtn">Clear Form</button>
    </div>
  </div>

  <!-- UPDATE -->
  <div class="page" id="page-update">
    <p class="info">Step 1: Neeche table se student select karein, phir "Load Selected Student" dabayein.</p>
    <div class="table-wrap"><table id="updateTable"></table></div>
    <div class="card" style="margin-top:20px;">
      <div class="form-grid">
        <div><label>Roll Number</label><input id="updRoll"></div>
        <div><label>Full Name</label><input id="updName"></div>
        <div><label>Course</label><input id="updCourse"></div>
        <div><label>Year</label>
          <select id="updYear"><option>FY</option><option>SY</option><option>TY</option><option>Other</option></select>
        </div>
        <div><label>Phone</label><input id="updPhone"></div>
        <div><label>Email</label><input id="updEmail"></div>
      </div>
      <button class="btn btn-secondary" id="loadBtn">Load Selected Student</button>
      <button class="btn btn-success" id="saveBtn">Save Changes</button>
      <button class="btn btn-secondary" id="clearUpdBtn">Clear Form</button>
    </div>
  </div>

  <!-- DELETE -->
  <div class="page" id="page-delete">
    <p class="info">Student select karein, phir delete karein. Ye undo nahi hota.</p>
    <div class="table-wrap"><table id="deleteTable"></table></div>
    <div class="actions">
      <button class="btn btn-danger" id="delBtn">Delete Selected Student</button>
    </div>
  </div>
</div>

<script>
  const KEY = "studenthub_students";
  let students = JSON.parse(localStorage.getItem(KEY) || "[]");
  let selectedRoll = null;
  let editingRoll = null;

  const titles = {
    dashboard: ["Dashboard", "Overview of student records."],
    students: ["Students", "View and search all student records."],
    add: ["Add Student", "Enter details to register a new student."],
    update: ["Update Student", "Select a student and update their details."],
    delete: ["Delete Student", "Select a student to remove their record."]
  };

  function save() { localStorage.setItem(KEY, JSON.stringify(students)); }

  function showPage(name) {
    document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
    document.getElementById("page-" + name).classList.add("active");
    document.querySelectorAll(".nav-btn").forEach(b => b.classList.toggle("active", b.dataset.page === name));
    document.getElementById("pageTitle").textContent = titles[name][0];
    document.getElementById("pageSub").textContent = titles[name][1];
    if (name === "dashboard") updateDashboard();
    if (name === "students" || name === "update" || name === "delete") renderAll();
  }

  document.querySelectorAll(".nav-btn").forEach(b => b.onclick = () => showPage(b.dataset.page));
  document.querySelectorAll("[data-goto]").forEach(b => b.onclick = () => showPage(b.dataset.goto));

  function updateDashboard() {
    document.getElementById("totalStudents").textContent = students.length;
    const courses = new Set(students.map(s => s.course.toLowerCase()));
    document.getElementById("totalCourses").textContent = courses.size;
  }

  // Table rendering
  function buildTable(tableId, list, onSelect) {
    const table = document.getElementById(tableId);
    if (list.length === 0) {
      table.innerHTML = `<tr><td class="empty">Koi student nahi mila.</td></tr>`;
      return;
    }
    table.innerHTML = `<tr><th>Roll No.</th><th>Full Name</th><th>Course</th><th>Year</th><th>Phone</th><th>Email</th></tr>` +
      list.map(s => `<tr data-roll="${s.roll}">
        <td>${esc(s.roll)}</td><td>${esc(s.name)}</td><td>${esc(s.course)}</td>
        <td>${esc(s.year)}</td><td>${esc(s.phone)}</td><td>${esc(s.email)}</td></tr>`).join("");
    table.querySelectorAll("tr[data-roll]").forEach(tr => {
      tr.onclick = () => {
        table.querySelectorAll("tr").forEach(r => r.classList.remove("selected"));
        tr.classList.add("selected");
        onSelect(tr.dataset.roll);
      };
    });
  }

  function esc(v) {
    return String(v ?? "").replace(/[&<>"']/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
  }

  function renderAll(filter = "") {
    const q = filter.trim().toLowerCase();
    const list = q ? students.filter(s => Object.values(s).join(" ").toLowerCase().includes(q)) : students;
    buildTable("studentsTable", list, roll => selectedRoll = roll);
    buildTable("updateTable", students, roll => selectedRoll = roll);
    buildTable("deleteTable", students, roll => selectedRoll = roll);
    updateDashboard();
  }

  // Search
  document.getElementById("searchBtn").onclick = () => renderAll(document.getElementById("searchInput").value);
  document.getElementById("searchInput").onkeyup = e => { if (e.key === "Enter") renderAll(e.target.value); };
  document.getElementById("resetBtn").onclick = () => { document.getElementById("searchInput").value = ""; renderAll(); };

  // Add
  document.getElementById("addBtn").onclick = () => {
    const s = {
      roll: addRoll.value.trim(),
      name: addName.value.trim(),
      course: addCourse.value.trim(),
      year: addYear.value,
      phone: addPhone.value.trim(),
      email: addEmail.value.trim()
    };
    const err = validate(s);
    if (err) return alert(err);
    if (students.some(x => x.roll.toLowerCase() === s.roll.toLowerCase())) return alert("Ye roll number pehle se hai.");
    students.push(s);
    save();
    clearAdd();
    alert("Student added successfully!");
    showPage("students");
  };
  function clearAdd() {
    ["addRoll","addName","addCourse","addPhone","addEmail"].forEach(id => document.getElementById(id).value = "");
    addYear.value = "FY";
  }
  document.getElementById("clearAddBtn").onclick = clearAdd;

  // Validation
  function validate(s) {
    if (!s.roll || !s.name || !s.course) return "Roll Number, Full Name aur Course zaroori hain.";
    if (s.phone && !/^[0-9+()\- ]{7,20}$/.test(s.phone)) return "Valid phone number daalein.";
    if (s.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s.email)) return "Valid email address daalein.";
    return null;
  }

  // Update
  document.getElementById("goUpdateBtn").onclick = () => {
    if (!selectedRoll) return alert("Pehle students table se student select karein.");
    showPage("update");
    loadSelected();
  };
  document.getElementById("loadBtn").onclick = loadSelected;
  function loadSelected() {
    if (!selectedRoll) return alert("Table se student select karein.");
    const s = students.find(x => x.roll === selectedRoll);
    if (!s) return alert("Record nahi mila.");
    editingRoll = s.roll;
    updRoll.value = s.roll; updName.value = s.name; updCourse.value = s.course;
    updYear.value = s.year; updPhone.value = s.phone; updEmail.value = s.email;
  }
  document.getElementById("saveBtn").onclick = () => {
    if (!editingRoll) return alert("Pehle student load karein.");
    const s = {
      roll: updRoll.value.trim(), name: updName.value.trim(), course: updCourse.value.trim(),
      year: updYear.value, phone: updPhone.value.trim(), email: updEmail.value.trim()
    };
    const err = validate(s);
    if (err) return alert(err);
    if (s.roll.toLowerCase() !== editingRoll.toLowerCase() &&
        students.some(x => x.roll.toLowerCase() === s.roll.toLowerCase())) return alert("Ye roll number pehle se hai.");
    const i = students.findIndex(x => x.roll === editingRoll);
    students[i] = s;
    editingRoll = s.roll;
    selectedRoll = s.roll;
    save();
    renderAll();
    alert("Student updated successfully!");
  };
  document.getElementById("clearUpdBtn").onclick = () => {
    ["updRoll","updName","updCourse","updPhone","updEmail"].forEach(id => document.getElementById(id).value = "");
    updYear.value = "FY";
    editingRoll = null;
  };

  // Delete
  function deleteSelected() {
    if (!selectedRoll) return alert("Pehle student select karein.");
    const s = students.find(x => x.roll === selectedRoll);
    if (!s || !confirm(`Delete record of ${s.name} (Roll No. ${s.roll})?`)) return;
    students = students.filter(x => x.roll !== selectedRoll);
    selectedRoll = null;
    save();
    renderAll();
  }
  document.getElementById("delBtn").onclick = deleteSelected;
  document.getElementById("delFromListBtn").onclick = deleteSelected;

  // Start
  renderAll();
  showPage("dashboard");
</script>
</body>
</html>